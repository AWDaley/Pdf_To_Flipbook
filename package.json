{
  "name": "paperbound-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A local PDF flipbook creator with an independent animated reader.",
  "engines": { "node": "24.13.0", "npm": "11.6.2" },
  "packageManager": "npm@11.6.2",
  "scripts": {
    "postinstall": "node scripts/patch-page-flip.mjs",
    "doctor": "node scripts/doctor.mjs",
    "dev": "node --import tsx apps/local-service/index.ts --dev",
    "dev:ui": "vite --host 127.0.0.1",
    "build": "npm run typecheck && node scripts/build.mjs",
    "start": "node --import tsx apps/local-service/index.ts",
    "convert": "node --import tsx packages/converter/cli.ts",
    "fixtures": "node scripts/generate-fixtures.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:reader": "playwright test --config playwright.reader.config.ts",
    "test:export": "playwright test --config playwright.export.config.ts",
    "verify": "node scripts/verify.mjs"
  },
  "dependencies": {
    "@napi-rs/canvas": "1.0.9",
    "archiver": "8.0.0",
    "fastify": "5.12.4",
    "page-flip": "2.0.7",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "6.3.289",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sharp": "0.35.4",
    "tsx": "4.23.13",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@types/archiver": "8.0.0",
    "@types/node": "24.13.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "10.10.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vite": "8.3.0",
    "vitest": "5.0.0"
  }
}
